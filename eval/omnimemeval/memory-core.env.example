# OmniMemEval answer stage: keep these identical to the reproduced comparison.
ANSWER_MODEL=gpt-4.1-mini-2025-04-14
ANSWER_API_KEY=
ANSWER_BASE_URL=https://api.openai.com/v1
EVAL_MODEL=gpt-4o-mini-2024-07-18
EVAL_API_KEY=
EVAL_BASE_URL=https://api.openai.com/v1

# Public Memory Core gRPC service.
MEMORY_CORE_ENDPOINT=http://127.0.0.1:8081
MEMORY_CORE_TOKEN=
MEMORY_CORE_OMNI_TENANT=omnimemeval
MEMORY_CORE_OMNI_AGENT_REF=omnimemeval-agent
MEMORY_CORE_OMNI_EPISODE_EVIDENCE_BYTES=16384
MEMORY_CORE_OMNI_TIMEOUT=30
MEMORY_CORE_OMNI_RPC_ATTEMPTS=5

# OmniMemEval common controls. The full public comparison uses 5,000 questions.
TOPK=20
LLM_WORKERS=10
