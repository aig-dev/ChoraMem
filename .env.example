# Copy to .env before `docker compose up --build`.
# Use URL-safe ASCII here because the same value is embedded in PostgreSQL's DSN.
MEMORY_POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
MEMORY_WORKER_OPENAI_MODEL=your-model-id
OPENAI_API_KEY=your-openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1

# Public Memory data-plane authentication. Use at least 32 random bytes for HS256.
MEMORYD_JWT_HS256_SECRET=replace-with-at-least-32-random-bytes
MEMORYD_JWT_ISSUER=your-memory-auth-issuer
MEMORYD_JWT_AUDIENCE=memory-core

# Optional consolidation window controls:
# MEMORYD_CONSOLIDATION_QUIET_PERIOD=2m
# MEMORYD_CONSOLIDATION_MAX_EPISODES=32
# MEMORYD_CONSOLIDATION_OVERLAP=4
# MEMORY_WORKER_MAX_INPUT_BYTES=262144
# MEMORY_WORKER_REASONING_EFFORT=none

# Optional rebuildable MemoryIndex Provider. The Core remains correct without it.
# MEMORYD_MEMORY_INDEX_GRPC_ADDR=host.docker.internal:50051
# MEMORYD_MEMORY_INDEX_RPC_TOKEN=shared-provider-token
# MEMORYD_MEMORY_INDEX_TIMEOUT=3s
# MEMORYD_MEMORY_INDEX_PROJECTOR_POLL_INTERVAL=1s
# MEMORYD_MEMORY_INDEX_PROJECTOR_LEASE_DURATION=30s
# MEMORYD_MEMORY_INDEX_PROJECTOR_RETRY_DELAY=5s
# MEMORYD_MEMORY_INDEX_PROJECTOR_PAGE_SIZE=128

# Host port overrides are useful when the Harness already owns port 8080.
# MEMORYD_HTTP_HOST_PORT=18080
# MEMORYD_GRPC_HOST_PORT=8081
